# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://privacy_user:privacy_pass@localhost:5432/privacy_gateway

# Redis (Encrypted Tokenization Vault)
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography (Generate strong random values for production)
JWT_SECRET=replace-with-at-least-32-char-random-jwt-secret
MAPPING_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-aes256-key

# External LLM Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_LLM_PROVIDER=gemini

# Runtime Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO
MAPPING_TTL_SECONDS=900
ENABLE_GLINER=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
